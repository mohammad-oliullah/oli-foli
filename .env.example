# MongoDB database used by the portfolio dashboard and feedback page.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# NextAuth session configuration.
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Passkeys: use the deployment origin and hostname in production.
PASSKEY_SETUP_SECRET=generate-a-long-random-setup-secret
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# Server-only key for the recruiter-facing Gemini assistant.
GEMINI_API_KEY=replace-with-your-gemini-api-key
